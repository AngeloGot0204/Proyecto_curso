# Copy to .env and fill in real values. Never commit .env.

# --- Requeridas: sin estas, Django no arranca (fallo explicito) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo acepta exactamente True o False. "true", "1" o "yes" son rechazados.
DJANGO_HTTPS_ONLY=False

# --- Opcionales ---
DJANGO_DEBUG=True
DJANGO_CSRF_TRUSTED_ORIGINS=
# Sentry: si no esta definida, no se inicializa y la app funciona igual.
SENTRY_DSN=
# Vercel la inyecta al conectar el Blob store. En produccion (DEBUG=False)
# es el backend de almacenamiento de plantillas, logos y adjuntos.
BLOB_READ_WRITE_TOKEN=
